#!/bin/bash
# fortisc: Fortran host + ML model (PyTorch export script or linalg .mlir) -> one executable.
# Usage: fortisc export.py|model_linalg.mlir host.f90 out
set -e
EXPORT=$1; HOST=$2; OUT=$3
PREFIX=@CMAKE_INSTALL_PREFIX@
B=@LLVM_TOOLS_BINARY_DIR@
CUDA=@CUDAToolkit_ROOT@
MATH=@MATH_LIBS_DIR@
CUDNN=@CUDNN_DIR@
MLIRLIB=@LLVM_LIBRARY_DIR@
VENV=${FORTIS_VENV:-$HOME/venvs/tmlir}
W=${FORTIS_WORK:-$PWD/fortisc_work}; mkdir -p $W

$B/flang -fc1 -emit-fir $HOST -o $W/host.fir
python3 $PREFIX/bin/fortis_hostinfo.py $W/host.fir mlp_forward > $W/hostinfo.json
export FORTIS_BATCH=$(python3 -c "import json;print(json.load(open('$W/hostinfo.json'))['batch'])")
export FORTIS_HOST_LOOP=$(python3 -c "import json;print(int(json.load(open('$W/hostinfo.json'))['in_loop']))")
export FORTIS_LOOP_BATCH=$(python3 -c "import json;d=json.load(open('$W/hostinfo.json'))['loop_batch'];print(d['trip'] if d else 0)")
if [ "$FORTIS_LOOP_BATCH" != "0" ]; then export FORTIS_BATCH=$FORTIS_LOOP_BATCH; echo "fortisc: loop over $FORTIS_LOOP_BATCH column slices proven pure -> batching the loop"; fi
# --- host arithmetic around the call: lift pure per-column expressions into the compiled step
$B/flang -fc1 -emit-hlfir $HOST -o $W/host.hlfir
python3 $PREFIX/bin/fortis_hostlift.py $W/host.hlfir mlp_forward > $W/lift.json
export FORTIS_LIFT=$(python3 -c "import json;print(int(json.load(open('$W/lift.json'))['ok']))")
if [ "$FORTIS_LIFT" = "1" ]; then
  export FORTIS_LOOP_BATCH=$(python3 -c "import json;print(json.load(open('$W/lift.json'))['trip'])"); export FORTIS_BATCH=$FORTIS_LOOP_BATCH
  export FORTIS_HOST_GLOBALS=$(python3 -c "import json;print(json.dumps(json.load(open('$W/lift.json'))['globals']))")
  export FORTIS_LIFT_IN_SYM=$(python3 -c "import json;print(json.load(open('$W/lift.json'))['in_sym'])")
  echo "fortisc: host expression around the call proven pure -> lifted into the batch-$FORTIS_BATCH step (reads $FORTIS_LIFT_IN_SYM, $FORTIS_HOST_GLOBALS)"
else
  echo "fortisc: no host expression lifted ($(python3 -c "import json;print(json.load(open('$W/lift.json'))['reason'])"))"
fi
# --- call-centric loop distribution: one analysis decides batching, lifting, and blocking
PYTHONPATH=$PREFIX/bin python3 $PREFIX/bin/fortis_loopdist.py $W/host.hlfir mlp_forward > $W/loop.json
LV=$(python3 -c "import json;print(json.load(open('$W/loop.json'))['verdict'])")
if [ -n "$FORTIS_NO_DIST" ]; then LV=disabled; fi
echo "fortisc: loop verdict $LV ($(python3 -c "import json;print(json.load(open('$W/loop.json'))['reason'][:100])"))"
if [ "$LV" = "batched" ]; then
  export FORTIS_LOOP_JSON=$W/loop.json
  export FORTIS_BATCH=$(python3 -c "import json;print(json.load(open('$W/loop.json'))['batch'])")
  export FORTIS_LOOP_BATCH=$FORTIS_BATCH
  export FORTIS_LIFT=$(python3 -c "import json;print(int(json.load(open('$W/loop.json'))['lift'] is not None))")
else
  unset FORTIS_LOOP_JSON FORTIS_HOST_GLOBALS FORTIS_LIFT_IN_SYM; export FORTIS_LOOP_BATCH=0; export FORTIS_LIFT=0
  export FORTIS_BATCH=$(python3 -c "import json;print(json.load(open('$W/hostinfo.json'))['batch'])")
fi
echo "fortisc: host call site batch=$FORTIS_BATCH in_loop=$FORTIS_HOST_LOOP"
if [[ "$EXPORT" == *.mlir ]]; then cp $EXPORT $W/model_linalg.mlir; else source $VENV/bin/activate && python $EXPORT > $W/model_linalg.mlir && deactivate; fi
if [ "$FORTIS_LIFT" = "1" ]; then
  python3 $PREFIX/bin/fortis_hostlift.py --prologue $W/lift.json $W/model_linalg.mlir > $W/model_lifted.mlir
  $B/mlir-opt $W/model_lifted.mlir -inline -symbol-dce -o $W/model_linalg.mlir
fi
python3 $PREFIX/bin/fortis_outline.py $W/model_linalg.mlir $W

$B/mlir-opt $W/model_args.mlir -linalg-generalize-named-ops -o $W/m1.mlir
$PREFIX/bin/fortis-opt $W/m1.mlir -fortis-fold-transpose -o $W/m2a.mlir
$B/mlir-opt $W/m2a.mlir -canonicalize -cse -o $W/m2.mlir
$B/mlir-opt $W/m2.mlir -one-shot-bufferize="bufferize-function-boundaries function-boundary-type-conversion=identity-layout-map" -buffer-results-to-out-params -o $W/m3.mlir
$PREFIX/bin/fortis-opt $W/m3.mlir -fortis-fuse -o $W/m4.mlir
$B/mlir-opt $W/m4.mlir -gpu-lower-to-nvvm-pipeline="cubin-chip=sm_70 cubin-format=fatbin" -o $W/m5.mlir
sed -i -e 's/[@]malloc/@fortis_alloc/g' -e 's/[@]free/@fortis_free/g' $W/m5.mlir
$B/mlir-translate $W/m5.mlir --mlir-to-llvmir -o $W/model.ll
$B/clang -O2 -c $W/model.ll -o $W/model.o

$B/mlir-translate $W/weights.mlir --mlir-to-llvmir -o $W/weights.ll
$B/clang -O2 -c $W/weights.ll -o $W/weights.o
LIBCALLS=$(grep -c "call @fortis_" $W/m4.mlir || true)
GRAPH=$(( FORTIS_HOST_LOOP == 1 && LIBCALLS == 0 ))
echo "fortisc: library calls=$LIBCALLS -> graph capture=$GRAPH"
$B/clang -O2 -DFORTIS_GRAPH_DEFAULT=$GRAPH -I$CUDA/include -c $W/shim.c -o $W/shim.o
$B/clang -O2 -I$CUDA/include -c $W/shim.c -o $W/shim.o

if [ -n "$FORTIS_LOOP_JSON" ]; then
  $B/flang -fc1 -emit-llvm -O3 $HOST -o $W/host.ll
  for sym in $(python3 -c "import json;d=json.load(open('$FORTIS_LOOP_JSON'));print(d['in'], d['out'], ' '.join(g['sym'] for g in (d['lift'] or {}).get('globals', [])))"); do
    sed -i "s/^@$sym = internal global/@$sym = global/" $W/host.ll; done
  $B/clang -O2 -c $W/host.ll -o $W/host.o; HOSTOBJ=$W/host.o
else HOSTOBJ=$HOST; fi
$B/flang -O3 $HOSTOBJ $W/model.o $W/shim.o $W/weights.o \
  -L$PREFIX/lib -lfortis_rt -L$MLIRLIB -lmlir_cuda_runtime -Wl,-rpath,$MLIRLIB -L$CUDA/lib64 -lcudart -Wl,-rpath,$CUDA/lib64 -L$MATH/lib64 -lcufft -lcublas -Wl,-rpath,$MATH/lib64 $CUDNN/lib/libcudnn.so.8 -Wl,-rpath,$CUDNN/lib -lstdc++ \
  -o $OUT
echo "fortisc: kernels=$(grep -c gpu.launch_func $W/m4.mlir)  -> $OUT"
